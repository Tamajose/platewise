# Set via supabase secrets set --env-file ... on a hosted deployment.
#
# Choose the AI service. Both are OpenAI-compatible. The default is openai.
# Vision, text and speech can each use a different service. Set
# PLATEWISE_VISION_PROVIDER, PLATEWISE_TEXT_PROVIDER or PLATEWISE_SPEECH_PROVIDER
# to override this for one capability.
PLATEWISE_AI_PROVIDER=groq
GROQ_API_KEY=replace_with_project_secret
# OPENAI_API_KEY=replace_with_project_secret

# Models. Defaults for groq: text openai/gpt-oss-120b, speech whisper-large-v3-turbo.
# Groq has no default vision model: its Llama 4 Scout was retired. Set one that
# accepts images, or leave photo and menu analysis off, or point
# PLATEWISE_VISION_PROVIDER at another service. Check Groq's current model list.
# Defaults for openai: gpt-4.1-mini (vision, text) and gpt-4o-mini-transcribe.
# PLATEWISE_VISION_MODEL=
# PLATEWISE_TEXT_MODEL=
# PLATEWISE_SPEECH_MODEL=

# How strictly the service must follow the response format: strict, schema or
# json. The default is strict for openai and schema for groq. Replies are always
# validated again. Use json if a model rejects schemas.
# PLATEWISE_STRUCTURED_OUTPUT=schema

PLATEWISE_BANGLA_TEXT_ENABLED=false
PLATEWISE_BANGLA_SPEECH_ENABLED=false
PLATEWISE_CLEANUP_SECRET=replace_with_random_secret
# Local emulator only. Comma-separated web origins, no wildcard.
PLATEWISE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
