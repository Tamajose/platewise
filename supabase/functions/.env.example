# Set via supabase secrets set --env-file ... on a hosted deployment.
OPENAI_API_KEY=replace_with_project_secret
PLATEWISE_AI_PROVIDER=openai
PLATEWISE_VISION_MODEL=gpt-4.1-mini
PLATEWISE_TEXT_MODEL=gpt-4.1-mini
PLATEWISE_SPEECH_MODEL=gpt-4o-mini-transcribe
PLATEWISE_BANGLA_TEXT_ENABLED=false
PLATEWISE_BANGLA_SPEECH_ENABLED=false
PLATEWISE_CLEANUP_SECRET=replace_with_random_secret
# Local emulator only. Comma-separated web origins, no wildcard.
PLATEWISE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
