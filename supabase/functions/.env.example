# Set via supabase secrets set --env-file ... on a hosted deployment.
#
# Choose the AI service: openai, groq or gemini. All three are used through
# OpenAI-style endpoints. Vision, text and speech can each use a different
# service. Set PLATEWISE_VISION_PROVIDER, PLATEWISE_TEXT_PROVIDER or
# PLATEWISE_SPEECH_PROVIDER to override this for one capability.
PLATEWISE_AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_project_secret
# GROQ_API_KEY=replace_with_project_secret
# OPENAI_API_KEY=replace_with_project_secret

# Gemini does speech too: the recording is sent with an instruction to
# transcribe it. To use another provider for voice notes instead, set
# PLATEWISE_SPEECH_PROVIDER=groq (with GROQ_API_KEY) or openai.
# PLATEWISE_SPEECH_PROVIDER=

# Models. Defaults: gemini gemini-3.5-flash-lite (vision, text, speech);
# groq openai/gpt-oss-120b (text) and whisper-large-v3-turbo (speech) and no
# vision; openai gpt-4.1-mini (vision, text) and gpt-4o-mini-transcribe.
# Model names change often. Check the provider's current list and set these
# if a default is retired.
# PLATEWISE_VISION_MODEL=
# PLATEWISE_TEXT_MODEL=
# PLATEWISE_SPEECH_MODEL=

# How the service is asked for structured replies: strict, schema, json or
# prompt. Defaults: strict for openai, schema for groq, prompt for gemini. Every
# reply is validated again whatever the mode. Try schema for gemini once its
# support is confirmed. Use prompt if a model rejects schemas.
# PLATEWISE_STRUCTURED_OUTPUT=prompt

# Phone verification through Banglalink's Applink OTP service. Both values come
# from the Applink developer portal after the app is approved. The service
# accepts calls only from addresses registered for the app, so if this function
# has none, point APPLINK_BASE_URL at a relay that does.
# APPLINK_APP_ID=
# APPLINK_PASSWORD=
# APPLINK_BASE_URL=https://api.applink.com.bd

# Banglalink subscription messages. The subscription-notify function accepts
# them only at an address that ends in ?token=<this value>. Use a long random
# value, and enter the full address in the Applink portal.
# SUBSCRIPTION_NOTIFY_TOKEN=replace_with_random_secret

# Inbound MO SMS from Applink. The sms-receive function accepts messages only at
# an address that ends in ?token=<this value>. Enter that full address as the
# Message Receiving URL in the Applink portal.
# SMS_RECEIVE_TOKEN=replace_with_random_secret

PLATEWISE_BANGLA_TEXT_ENABLED=false
PLATEWISE_BANGLA_SPEECH_ENABLED=false
PLATEWISE_CLEANUP_SECRET=replace_with_random_secret
# Local emulator only. Comma-separated web origins, no wildcard.
PLATEWISE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
